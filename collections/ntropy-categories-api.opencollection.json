{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference Account Holder categories API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "categories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve category set",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ntropy.com/v3/categories/:id",
            "headers": [
              {
                "name": "X-Api-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the set of categories. Category sets are different per account holder type."
        },
        {
          "info": {
            "name": "Set a custom set of categories",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ntropy.com/v3/categories/:id",
            "headers": [
              {
                "name": "X-Api-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets a custom set of categories. Transactions that don't match a category will be categorized `not enough information` regardless of whether it is present in the set."
        },
        {
          "info": {
            "name": "Reset category set to original values",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ntropy.com/v3/categories/:id/reset",
            "headers": [
              {
                "name": "X-Api-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Resets the set of categories of the specified account holder type to the original values."
        }
      ]
    }
  ],
  "bundled": true
}