{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference Account Holder reports API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ntropy.com/v3/reports",
            "headers": [
              {
                "name": "X-Api-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "created_after",
                "value": "",
                "type": "query",
                "description": "Only return report older or equal than this date"
              },
              {
                "name": "created_before",
                "value": "",
                "type": "query",
                "description": "Only return report newer than this date"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Starting point for the set of report"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The limit of report to be returned"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "If specified, only return reports with this status"
              }
            ]
          },
          "docs": "List all reports"
        },
        {
          "info": {
            "name": "Create a report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ntropy.com/v3/reports",
            "headers": [
              {
                "name": "X-Api-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Report a transaction with incorrect fields.\n\nComplete guide: [Reports](../../../enrichment/reports)."
        },
        {
          "info": {
            "name": "Retrieve a report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ntropy.com/v3/reports/:id",
            "headers": [
              {
                "name": "X-Api-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a report"
        },
        {
          "info": {
            "name": "Delete a report",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ntropy.com/v3/reports/:id",
            "headers": [
              {
                "name": "X-Api-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a report"
        }
      ]
    }
  ],
  "bundled": true
